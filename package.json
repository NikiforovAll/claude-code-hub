{
  "name": "claude-code-hub",
  "version": "1.0.1",
  "description": "Unified hub for Claude Code tools — Marketplace + Kanban in one PWA",
  "main": "server.js",
  "bin": {
    "claude-code-hub": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js --open",
    "test": "node --test test/*.test.js packages/claude-hub-sdk/test/*.test.js",
    "update": "bash scripts/update-submodules.sh",
    "update:check": "bash scripts/update-submodules.sh --check",
    "lint": "npx @biomejs/biome check public/app.js server.js packages/claude-hub-sdk && npm run check:escaping && npm run check:security-lib",
    "lint:fix": "npx @biomejs/biome check --fix public/app.js server.js packages/claude-hub-sdk",
    "prepare": "husky",
    "check:escaping": "node scripts/check-escaping.mjs",
    "check:security-lib": "bash scripts/sync-security-lib.sh --check",
    "sdk:sync": "node scripts/sdk-sync.mjs",
    "perf": "node scripts/perf.mjs run",
    "perf:compare": "node scripts/perf.mjs compare",
    "perf:report": "node scripts/perf.mjs report",
    "perf:world": "node scripts/perf.mjs gen-world"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikiforovAll/claude-code-hub.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "hub",
    "dashboard",
    "marketplace",
    "kanban",
    "pwa",
    "developer-tools"
  ],
  "author": "NikiforovAll",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NikiforovAll/claude-code-hub/issues"
  },
  "homepage": "https://github.com/NikiforovAll/claude-code-hub#readme",
  "dependencies": {
    "claude-code-cost": "1.0.0",
    "claude-code-kanban": "5.1.0",
    "claude-code-marketplace": "1.0.0",
    "claude-code-memory-explorer": "1.0.0",
    "express": "^4.21.0",
    "open": "^10.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "server.js",
    "public/**/*",
    "lib/**/*",
    "plugin/**/*",
    "packages/claude-hub-sdk/src/**/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "husky": "^9.1.7"
  }
}
