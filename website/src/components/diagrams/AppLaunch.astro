---
import Diagram from './Diagram.astro';
---

<Diagram title="The states of an app process" viewBox="0 0 760 270">
  <rect x="10" y="40" width="150" height="60" rx="8" class="d-box" />
  <text x="85" y="65" class="d-title">Spawn</text>
  <text x="85" y="85" class="d-note">run.entry, with IPC</text>

  <rect x="200" y="40" width="160" height="60" rx="8" class="d-box" />
  <text x="280" y="65" class="d-title">Starting</text>
  <text x="280" y="85" class="d-note">the hub waits up to 20 s</text>

  <rect x="440" y="40" width="160" height="60" rx="8" class="d-box d-box-hub" />
  <text x="520" y="65" class="d-title">Running</text>
  <text x="520" y="85" class="d-note">port from the ready line</text>

  <line x1="160" y1="70" x2="198" y2="70" class="d-link" />
  <line x1="360" y1="70" x2="438" y2="70" class="d-link" />
  <text x="399" y="62" class="d-note">ready line</text>

  <rect x="430" y="160" width="180" height="60" rx="30" class="d-box" />
  <text x="520" y="186" class="d-title">Fewer than 5</text>
  <text x="520" y="204" class="d-note">restarts in 60 s?</text>
  <line x1="520" y1="100" x2="520" y2="158" class="d-link" />
  <text x="528" y="134" class="d-note d-start">exits</text>

  <path d="M430 190 H300 V102" class="d-link" />
  <text x="365" y="182" class="d-note d-yes">yes, after 0.5 s</text>

  <rect x="640" y="160" width="110" height="60" rx="8" class="d-box" />
  <text x="695" y="186" class="d-title">Stopped</text>
  <text x="695" y="204" class="d-note">gave up</text>
  <line x1="610" y1="190" x2="638" y2="190" class="d-link" />
  <text x="624" y="182" class="d-note d-no">no</text>

  <path d="M695 220 V250 H250 V102" class="d-link d-link-dashed" />
  <text x="472" y="242" class="d-note">Ctrl+R in the app launcher starts it again and resets the count</text>
</Diagram>
