---
import SiteLayout from '../kit/SiteLayout.astro';
import ModeToggle from '../kit/ModeToggle.astro';
import ThemeDial from '../kit/ThemeDial.astro';
import Lightbox from '../kit/Lightbox.astro';
import FamilyFooter from '../kit/FamilyFooter.astro';
import { family, url } from '../kit/family';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const DOCS = url('extensibility/extensions/');
const GITHUB = 'https://github.com/NikiforovAll/claude-code-hub';
---

<SiteLayout title={title} description={description} image="og.png">
  <div class="page">
    <header class="nav">
      <a class="mark" href={url()}>Claude Code Hub</a>
      <nav aria-label="Site">
        <a href={DOCS}>Docs</a>
        <details class="family">
          <summary>Apps</summary>
          <ul>
            {family.map((s) => <li><a href={s.href}>{s.name}</a></li>)}
          </ul>
        </details>
        <a href={url('extensions/')}>Extensions</a>
        <a href={GITHUB}>GitHub</a>
        <ThemeDial compact />
        <ModeToggle />
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <FamilyFooter
      current="hub"
      links={[
        { label: 'Extensions', href: url('extensions/') },
        { label: 'Docs', href: DOCS },
        { label: 'GitHub', href: GITHUB },
      ]}
    />
  </div>
  <Lightbox />
</SiteLayout>

<style>
  .page {
    width: min(100% - 2rem, 78rem);
    margin-inline: auto;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }
  .mark {
    font: 600 1.25rem/1 var(--font-display);
    color: var(--c-ink1);
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font: 500 0.875rem var(--font-mono);
  }
  .nav nav a,
  .family summary {
    color: var(--c-ink2);
    text-decoration: none;
    cursor: pointer;
  }
  .nav nav a:hover,
  .family summary:hover {
    color: var(--c-ink1);
  }
  .nav a:focus-visible,
  .family summary:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }
  .family {
    position: relative;
  }
  .family summary {
    list-style: none;
  }
  .family summary::-webkit-details-marker {
    display: none;
  }
  .family summary::after {
    content: ' ▾';
  }
  .family ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 10;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    min-width: 11rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.5rem;
  }
  .family li a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }
  .family li a:hover {
    background: var(--c-hover);
  }
  main {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(4rem, 8vw, 6rem);
  }
  @media (max-width: 40rem) {
    .nav nav {
      gap: 0.875rem;
    }
  }
  @media (max-width: 30rem) {
    .nav {
      flex-wrap: wrap;
    }
    .nav nav {
      position: relative;
    }
    .nav :global(.dial-pop) {
      position: static;
    }
  }
</style>
