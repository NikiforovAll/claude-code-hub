---
import Shell from '../../extensions/Shell.astro';
import { url } from '../../kit/family';
import { loadExtensions, onSite, type Extension } from '../../extensions/load';

export async function getStaticPaths() {
  return (await loadExtensions()).map((x) => ({ params: { id: x.id }, props: { x } }));
}

const { x } = Astro.props as { x: Extension };
const { requires } = x;
const addon = x.kind === 'addon';
const feature = x.kind === 'feature';
const OS = { win32: 'Windows', darwin: 'macOS', linux: 'Linux' } as Record<string, string>;
const tools = (requires.tools ?? []).filter((t) => !t.optional);
const optionalTools = (requires.tools ?? []).filter((t) => t.optional);
const needs = [
  requires.hub && `Claude Code Hub ${requires.hub} or later`,
  requires.node && `Node.js ${requires.node} or later`,
  requires.os && requires.os.map((o) => OS[o] ?? o).join(' or '),
  ...tools.filter((t) => !t.url).map((t) => t.name),
  ...(addon ? ['Claude Code Kanban'] : (requires.apps ?? []).map((id) => `the ${id} app enabled in the hub`)),
].filter(Boolean) as string[];
const linkedTools = tools.filter((t) => t.url);
const facts = [
  ['Kind', addon ? 'Kanban dock add-on' : feature ? 'Hub feature' : 'Hub app'],
  ['Author', x.author],
  ['License', x.license],
  ['Requires', needs.join(', ')],
  ['Works better with', optionalTools.length > 0 && ' '],
  ['Claude Code plugin', x.plugin],
].filter(([, v]) => v);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: x.name,
  description: x.description ?? x.tagline,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  url: new URL(url(`extensions/${x.id}/`), Astro.site).href,
  ...(x.author && { author: { '@type': 'Person', name: x.author } }),
  ...(x.license && { license: `https://spdx.org/licenses/${x.license}.html` }),
  ...(x.screenshots[0] && { screenshot: x.screenshots[0].src }),
};
---

<Shell title={`${x.name} · Claude Code Hub extension`} description={x.tagline}>
  <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  <a class="back" href={url('extensions/')}>All extensions</a>

  <section class="head">
    <h1>
      {x.name}
      {x.official && <span class="badge">Official</span>}
      {addon && <span class="badge">Add-on</span>}
      {feature && <span class="badge">Feature</span>}
    </h1>
    <p class="lede">{x.tagline}</p>
    {x.description && <p class="description">{x.description}</p>}
    {
      x.tags.length > 0 && (
        <p class="tags">
          {x.tags.map((t) => <span class="tag">{t}</span>)}
        </p>
      )
    }
  </section>

  <div class="body">
    <section aria-labelledby="install">
      <h2 id="install">Install</h2>
      <pre><code>{x.install}</code></pre>
      {
        feature ? (
          <p>
            The hub ships the code of a feature, so nothing is cloned. <code>ext install</code> checks that {tools.map((t) => t.name).join(' and ') || 'the hub can run it'} {tools.length ? 'is installed' : ''} and turns {x.name.toLowerCase()} on in the hub's <code>config.json</code>.
            Restart the hub. <code>claude-code-hub ext remove {x.id}</code> turns it off again.{' '}
            {x.homepage && <a href={x.homepage}>Read the guide</a>}
          </p>
        ) : addon ? (
          <p>
            <code>ext install</code> finds {x.id} in this registry, clones it into the hub dir with git and puts it on the Kanban dock of your Claude config dir.
            No restart is needed: every session shows it, and Kanban starts its server the first time you open it from the dock rail.{' '}
            <a href={url('extensibility/extensions/#add-ons')}>Read how add-ons work</a>.
          </p>
        ) : (
          <p>
            <code>ext install</code> finds {x.id} in this registry and clones it into the hub dir with git{x.plugin && <> and installs the {x.plugin} plugin in your Claude config dir</>}.
            Restart the hub, and the app gets the next tab.
          </p>
        )
      }
    </section>

    <section aria-labelledby="about">
      <h2 id="about">About</h2>
      <dl>
        {
          facts.map(([k, v]) => (
            <>
              <dt>{k}</dt>
              <dd>
                {k === 'Works better with'
                  ? optionalTools.map((t, i) => <>{i > 0 && ', '}{t.url ? <a href={t.url}>{t.name}</a> : t.name}</>)
                  : v}
                {k === 'Requires' && linkedTools.map((t) => <>, <a href={t.url}>{t.name}</a></>)}
              </dd>
            </>
          ))
        }
        <dt>Source</dt>
        <dd><a href={x.tree}>{x.source.replace(/^github:/, '')}{x.pinned && ` at ${x.sha.slice(0, 7)}`}</a></dd>
        {
          x.homepage && (
            <>
              <dt>Home page</dt>
              <dd><a href={x.homepage}>{x.homepage}</a></dd>
            </>
          )
        }
      </dl>
    </section>
  </div>

  {
    x.screenshots.length > 0 && (
      <section class="shots" aria-label="Screenshots">
        {x.screenshots.map((s) => (
          <figure>
            <button type="button" class="shot" data-lightbox aria-label={`Enlarge: ${s.alt}`}>
              <img src={onSite(s.src)} alt={s.alt} loading="lazy" decoding="async" />
            </button>
            {(s.title || s.caption) && (
              <figcaption>
                {s.title && <strong>{s.title}</strong>}
                {s.caption && <span>{s.caption}</span>}
              </figcaption>
            )}
          </figure>
        ))}
      </section>
    )
  }
</Shell>

<style>
  .back {
    font: 500 0.875rem var(--font-mono);
    color: var(--c-ink2);
    text-decoration: none;
  }
  .back::before {
    content: '← ';
  }
  .back:hover {
    color: var(--c-ink1);
  }
  .head {
    margin-top: 1.5rem;
    max-width: 44rem;
  }
  h1 {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font: 600 clamp(2.5rem, 6vw, 4.5rem) / 1 var(--font-display);
    letter-spacing: -0.025em;
  }
  .badge {
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.3125rem 0.625rem;
    border-radius: 999px;
    color: var(--c-accent-ink);
    border: 1px solid currentColor;
  }
  .lede {
    margin: 1.25rem 0 0;
    font-size: 1.25rem;
    color: var(--c-ink1);
  }
  .description {
    margin: 0.75rem 0 0;
    color: var(--c-ink2);
  }
  .tags {
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tag {
    font: 500 0.75rem/1 var(--font-mono);
    padding: 0.3125rem 0.5rem;
    border-radius: 0.25rem;
    color: var(--c-ink3);
    background: var(--c-elevated);
  }
  .body {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 2rem clamp(2rem, 5vw, 4rem);
  }
  h2 {
    margin: 0 0 1rem;
    font: 600 1.625rem/1.2 var(--font-display);
  }
  pre {
    margin: 0 0 1rem;
    padding: 0.875rem 1rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .body p {
    margin: 0;
    color: var(--c-ink2);
    font-size: 0.9375rem;
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.5rem;
  }
  dt {
    font: 500 0.8125rem/1.65 var(--font-mono);
    color: var(--c-ink3);
  }
  dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .shots {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: grid;
    gap: 2.5rem;
  }
  figure {
    margin: 0;
    border: 1px solid var(--c-border);
    border-radius: 0.625rem;
    overflow: hidden;
    background: var(--c-surface);
  }
  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .shot:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: -2px;
  }
  .back:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 3px;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 1.125rem 1rem;
    border-top: 1px solid var(--c-border);
    color: var(--c-ink2);
  }
  figcaption strong {
    font: 600 1rem var(--font-mono);
    color: var(--c-ink1);
  }
  @media (max-width: 30rem) {
    dl {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }
    dd {
      margin-bottom: 0.625rem;
    }
  }
</style>
