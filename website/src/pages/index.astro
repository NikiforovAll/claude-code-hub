---
import SiteLayout from '../kit/SiteLayout.astro';
import Shot from '../kit/Shot.astro';
import Keys from '../kit/Keys.astro';
import ModeToggle from '../kit/ModeToggle.astro';
import ThemeDial from '../kit/ThemeDial.astro';
import Lightbox from '../kit/Lightbox.astro';
import Video from '../kit/Video.astro';
import FamilyFooter from '../kit/FamilyFooter.astro';
import HubBuilderDemo from '../components/landing/HubBuilderDemo.astro';
import { family, url } from '../kit/family';

const GITHUB = 'https://github.com/NikiforovAll/claude-code-hub';
const NPM = 'https://www.npmjs.com/package/claude-code-hub';
const INSTALL = 'npx claude-code-hub --open';

const tools = [
  {
    title: 'Kanban',
    body: 'Tasks, sessions, and live agent activity on one board. Start a new Claude Code session or resume an old one in the embedded terminal, without leaving the window.',
    shot: 'terminal',
    alt: 'Kanban in zen mode with a Claude Code session running in the embedded terminal',
    docs: 'https://nikiforovall.blog/claude-code-kanban/',
  },
  {
    title: 'Marketplace',
    body: 'Browse the plugins and skills from your marketplaces, see what is installed, and read a skill before you add it.',
    shot: 'marketplace',
    alt: 'Marketplace with the plugin list and an installed plugin open',
    docs: 'https://nikiforovall.blog/claude-code-marketplace/',
  },
  {
    title: 'Cost',
    body: 'What your Claude Code usage costs, by day, by project, and by session, read from the transcripts on your disk.',
    shot: 'h2-hub-cost',
    alt: 'Cost dashboard with daily spend, cost by model, and the top projects',
    docs: 'https://nikiforovall.blog/claude-code-cost/',
  },
  {
    title: 'Memory Diagnoser',
    body: 'Every CLAUDE.md, rule, and auto memory file that Claude Code loads for a project, in one tree. Let Claude find what is stale or in conflict.',
    shot: 'h3-hub-memory',
    alt: 'Memory Diagnoser with the memory tree and the project CLAUDE.md open',
    docs: 'https://nikiforovall.blog/claude-code-memory/',
  },
  {
    title: 'Inspector',
    body: 'The turns, tool calls, and token use of one session, with the failed calls and the context size after each turn. It follows the session you open in Kanban. An example app in the hub repo: you add it to the hub yourself.',
    shot: 'inspector',
    alt: 'The Inspector with a chart of the context size per turn, the first turns with their tool calls, and the tools that the session used',
    docs: url('inspector/'),
    more: 'See the Inspector',
  },
];

const drive = [
  {
    title: 'Move with the keyboard',
    body: 'The hub has no tabs or buttons of its own. [Ctrl+Alt+→] and [Ctrl+Alt+←] go to the next or previous tool, and [Alt+1] to [Alt+4] jump to one. The keys work while focus is inside a tool. Press [?] in any tool for its own keys.',
    shot: '12-shortcuts',
    alt: 'The Kanban keyboard shortcuts help, with a group for the hub keys',
  },
  {
    title: 'Start a session from the board',
    body: 'Press [Ctrl+Alt+N] in Kanban, pick a folder, and type the first prompt. Claude Code starts in the embedded terminal, in a new git worktree if you ask for one. [Ctrl+Alt+R] resumes a past session.',
    shot: '09-new-session',
    alt: 'The New session dialog in Kanban with a project folder, a session name, and a prompt',
  },
];

const setup = [
  {
    title: 'Start the hub',
    cmd: INSTALL,
    body: 'It starts the four tools and opens the browser. To get a window with no browser UI, install the page as an app.',
  },
  {
    title: 'Install the Kanban hooks',
    cmd: 'npx claude-code-kanban --install',
    body: 'Optional. The hooks give Kanban the live agent log, subagents, and waiting-for-you badges. Run it once for each config dir.',
  },
  {
    title: 'Install the hub plugin',
    cmd: 'npx claude-code-hub --install',
    body: 'Optional. The plugin adds the hub-builder skill to Claude Code, so an agent can extend the hub, make a color theme, or fix a hub problem. Run it once for each config dir.',
  },
];
---

<SiteLayout
  title="Claude Code Hub: Kanban, Marketplace, Cost, and Memory Diagnoser in one window"
  description="Kanban, Marketplace, Cost, and Memory Diagnoser for Claude Code in one window, driven from the keyboard."
  image="og.png"
>
  <div class="page">
    <header class="nav">
      <a class="mark" href={url()}>Claude Code Hub</a>
      <nav aria-label="Site">
        <a href={url('getting-started/')}>Docs</a>
        <a href={GITHUB}>GitHub</a>
        <details class="family">
          <summary>Apps</summary>
          <ul>
            {family.map((s) => <li><a href={s.href} aria-current={s.id === 'hub' ? 'page' : undefined}>{s.name}</a></li>)}
          </ul>
        </details>
        <ModeToggle />
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>Four Claude Code tools, one window, no mouse.</h1>
        <p class="lede">
          Kanban, Marketplace, Cost, and Memory Diagnoser run side by side on your machine. One command starts them, and
          one keyboard moves between them.
        </p>
        <div class="actions">
          <div class="cmd">
            <code><span aria-hidden="true">$ </span>{INSTALL}</code>
            <button type="button" class="copy" data-copy={INSTALL}>Copy</button>
          </div>
          <a class="button" href={url('getting-started/')}>Read the docs</a>
        </div>

        <figure class="hero-shot">
          <Shot
            themed="board"
            alt="Claude Code Hub showing Kanban: sessions in the sidebar, task columns, and the agent log of the selected session"
            eager
          />
          <figcaption>
            <ThemeDial />
            <p>The 17 themes the hub ships with, in light and dark. Pick one in any tool and all four follow. Pick one here and the page follows.</p>
          </figcaption>
        </figure>
      </section>

      <section class="half" aria-labelledby="tour">
        <div class="half-head">
          <h2 id="tour">Tour</h2>
          <p>
            Go through the four tools, open the cost of one session from Kanban, and switch the theme. 37 seconds, with
            sound.
          </p>
        </div>
        <Video title="Claude Code Hub tour" light="9tMiNn1v6bY" dark="avZk-3qOpWk" poster="video/hub-{mode}.webp" />
      </section>

      <section class="half" aria-labelledby="tools">
        <div class="half-head">
          <h2 id="tools">Tools</h2>
          <p>
            Each tool is its own npm package and works alone too. The hub starts all four, frames them in one page, and
            keeps their theme and project in step.
          </p>
          <p class="aside">
            From a Kanban session, <kbd>$</kbd> opens its cost, <kbd>M</kbd> the Marketplace for its project, and
            <kbd>Ctrl+M</kbd> its memory files.
          </p>
        </div>
        <div class="items">
          {
            tools.map((it) => (
              <article class="item">
                <div class="item-text">
                  <h3>{it.title}</h3>
                  <p><Keys text={it.body} /> <a href={it.docs}>{it.more ?? 'Read the docs'}</a>.</p>
                </div>
                <Shot themed={it.shot} alt={it.alt} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="half" aria-labelledby="drive">
        <div class="half-head">
          <h2 id="drive">Drive</h2>
          <p>
            Press <kbd>Ctrl+Alt+P</kbd> and pick a project, and every tool switches to it. Press <kbd>Ctrl+Alt+W</kbd> to
            switch the Claude config dir, for example from work to personal.
          </p>
          <p class="aside">
            Everything runs on <code>localhost</code>. The hub page asks for the token that the startup banner prints.
          </p>
        </div>
        <div class="items">
          {
            drive.map((it) => (
              <article class="item">
                <div class="item-text">
                  <h3>{it.title}</h3>
                  <p><Keys text={it.body} /></p>
                </div>
                <Shot themed={it.shot} alt={it.alt} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="half" aria-labelledby="build">
        <div class="half-head">
          <h2 id="build">Build</h2>
          <p>
            Ask Claude Code to change the hub. The hub-builder skill knows how the hub runs its tools, so the agent
            picks a patch, a fork or a new app, and reads the docs page for it.
          </p>
          <p class="aside">
            Step 3 of the setup below adds the skill. Then type <code>/hub-builder</code> and your request.
          </p>
        </div>
        <HubBuilderDemo />
      </section>

      <section class="setup" aria-labelledby="setup">
        <h2 id="setup">Set up</h2>
        <ol>
          {
            setup.map((s) => (
              <li>
                <h3>{s.title}</h3>
                {s.cmd && <code class="step-cmd">{s.cmd}</code>}
                {s.body && <p><Keys text={s.body} /></p>}
              </li>
            ))
          }
        </ol>
      </section>
    </main>

    <FamilyFooter
      current="hub"
      links={[
        { label: 'npm', href: NPM },
        { label: 'GitHub', href: GITHUB },
      ]}
    />
  </div>
  <Lightbox />
</SiteLayout>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .page {
    width: min(100% - 2rem, 78rem);
    margin-inline: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
  }
  .mark {
    font: 600 1.25rem/1 var(--font-display);
    color: var(--c-ink1);
    text-decoration: none;
  }
  .nav nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font: 500 0.875rem var(--font-mono);
  }
  .nav nav a,
  .family summary {
    color: var(--c-ink2);
    text-decoration: none;
    cursor: pointer;
  }
  .nav nav a:hover,
  .family summary:hover {
    color: var(--c-ink1);
  }
  .family {
    position: relative;
  }
  .family summary {
    list-style: none;
  }
  .family summary::-webkit-details-marker {
    display: none;
  }
  .family summary::after {
    content: ' ▾';
  }
  .family ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    z-index: 10;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    min-width: 11rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.5rem;
  }
  .family li a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
  }
  .family li a:hover {
    background: var(--c-hover);
  }
  .family li a[aria-current='page'] {
    color: var(--c-accent-ink);
  }

  .hero {
    padding-block: clamp(2.5rem, 7vw, 6rem) 0;
  }
  h1 {
    margin: 0;
    font: 600 clamp(2.5rem, 6.4vw, 5.75rem) / 0.98 var(--font-display);
    letter-spacing: -0.025em;
    max-width: 22ch;
  }
  .lede {
    margin: 1.75rem 0 0;
    max-width: 38rem;
    font-size: 1.1875rem;
    color: var(--c-ink2);
  }
  .actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cmd {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.375rem 0.375rem 1rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.5rem;
    max-width: 100%;
  }
  .cmd code {
    font-size: 0.9375rem;
    white-space: nowrap;
    overflow-x: auto;
  }
  .cmd code span {
    color: var(--c-muted);
  }
  .copy,
  .button {
    font: 500 0.875rem/1 var(--font-mono);
    padding: 0.625rem 0.875rem;
    border-radius: 0.375rem;
    cursor: pointer;
    text-decoration: none;
  }
  .copy {
    color: var(--c-ink2);
    background: transparent;
    border: 1px solid transparent;
    min-width: 5.5rem;
  }
  .copy:hover {
    background: var(--c-hover);
  }
  .button {
    display: inline-flex;
    align-items: center;
    color: var(--c-field);
    background: var(--c-ink1);
    border: 1px solid var(--c-ink1);
  }
  .button:hover {
    background: var(--c-accent-ink);
    border-color: var(--c-accent-ink);
  }
  .copy:focus-visible,
  .button:focus-visible,
  .nav a:focus-visible,
  .family summary:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  .hero-shot {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  }
  .hero-shot figcaption {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.75rem;
  }
  .hero-shot figcaption p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-ink3);
  }

  .half {
    margin-top: clamp(5rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) 1fr;
    gap: 2rem clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .half-head {
    position: sticky;
    top: 2rem;
  }
  .half-head h2 {
    margin: 0 0 1rem;
    font: 600 clamp(3.5rem, 8vw, 6rem) / 0.9 var(--font-display);
    letter-spacing: -0.03em;
    color: var(--c-accent-ink);
  }
  .half-head p {
    margin: 0 0 1rem;
    color: var(--c-ink2);
  }
  .aside {
    font-size: 0.9375rem;
    color: var(--c-ink3);
  }
  .half-head code,
  .groups-text code,
  .item-text code {
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    margin: 0 0.15em;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: 0.3em;
    white-space: nowrap;
  }
  @media (max-width: 360px) {
    .half-head code,
    .groups-text code,
    .item-text code {
      white-space: normal;
      overflow-wrap: anywhere;
      box-decoration-break: clone;
    }
  }
  .items {
    display: grid;
    gap: clamp(3.5rem, 6vw, 5.5rem);
  }
  .item {
    display: grid;
    gap: 1.25rem;
  }
  .item-text {
    max-width: 40rem;
  }
  .item h3,
  .setup h3 {
    margin: 0 0 0.5rem;
    font: 600 1.625rem/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .item p {
    margin: 0;
    color: var(--c-ink2);
  }
  .groups {
    margin-top: clamp(5rem, 10vw, 9rem);
    display: grid;
    grid-template-columns: minmax(14rem, 22rem) 1fr;
    gap: 2rem clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  h2 {
    margin: 0 0 1rem;
    font: 600 clamp(2rem, 4vw, 2.75rem) / 1.08 var(--font-display);
    letter-spacing: -0.02em;
  }
  .groups p {
    margin: 0;
    color: var(--c-ink2);
  }

  .setup {
    margin-block: clamp(5rem, 10vw, 9rem) clamp(4rem, 8vw, 6rem);
  }
  .setup ol {
    margin: 2rem 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
  }
  .setup li {
    counter-increment: step;
    padding-top: 1.25rem;
    border-top: 2px solid var(--c-ink1);
  }
  .setup li::before {
    content: counter(step);
    display: block;
    font: 600 1rem var(--font-mono);
    color: var(--c-accent-ink);
    margin-bottom: 0.5rem;
  }
  .step-cmd {
    display: block;
    margin: 0.75rem 0;
    padding: 0.625rem 0.875rem;
    background: var(--c-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    overflow-x: auto;
    white-space: nowrap;
  }
  .setup li p {
    margin: 0;
    color: var(--c-ink2);
    font-size: 0.9375rem;
  }

  @media (max-width: 52rem) {
    .half,
    .groups {
      grid-template-columns: 1fr;
    }
    .half-head {
      position: static;
    }
    .nav nav {
      gap: 0.875rem;
    }
  }
</style>
